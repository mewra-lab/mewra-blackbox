{
  "name": "mewra-blackbox",
  "displayName": "Mewra Blackbox",
  "description": "Approved local browser journeys and human-reviewed visual regression for Mewra PreFlight.",
  "version": "0.3.0",
  "publisher": "mewra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mewra-lab/mewra-blackbox.git"
  },
  "engines": {
    "vscode": "^1.102.0",
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.1",
  "categories": [
    "Testing"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onMcpServerDefinitionProvider:mewra-blackbox"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "mewra-blackbox.approve",
        "title": "Blackbox: Review and Approve Configuration"
      },
      {
        "command": "mewra-blackbox.run",
        "title": "Blackbox: Run Approved Scenario"
      },
      {
        "command": "mewra-blackbox.runAll",
        "title": "Blackbox: Run Approved Full Suite"
      },
      {
        "command": "mewra-blackbox.cancel",
        "title": "Blackbox: Cancel Run"
      },
      {
        "command": "mewra-blackbox.results",
        "title": "Blackbox: Open Results"
      },
      {
        "command": "mewra-blackbox.secret",
        "title": "Blackbox: Set Named Secret"
      },
      {
        "command": "mewra-blackbox.install",
        "title": "Blackbox: Install Chromium"
      },
      {
        "command": "mewra-blackbox.baseline",
        "title": "Blackbox: Review Visual Baseline"
      },
      {
        "command": "mewra-blackbox.proposals",
        "title": "Blackbox: Review Agent Proposals"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "mewra-blackbox",
        "label": "Mewra Blackbox"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".mewra-blackbox.json",
        "url": "./schemas/blackbox.schema.json"
      }
    ]
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "BLACKBOX_BROWSER_TESTS=1 vitest run tests/browser",
    "test:extension": "node scripts/test-extension.mjs",
    "build": "node scripts/build.mjs",
    "validate": "pnpm format:check && pnpm check && pnpm test && pnpm build",
    "vscode:prepublish": "pnpm build",
    "package": "vsce package --no-dependencies --allow-missing-repository --out mewra-blackbox.vsix && node scripts/audit-package.mjs",
    "skills:verify": "node scripts/skills.mjs"
  },
  "lint-staged": {
    "*.{ts,mjs,json,css,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "ipaddr.js": "2.2.0",
    "minimatch": "10.2.6",
    "pixelmatch": "7.1.0",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/vscode": "1.102.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.0",
    "esbuild": "0.25.10",
    "husky": "9.1.7",
    "lint-staged": "16.2.3",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "zod-to-json-schema": "3.25.0"
  }
}
